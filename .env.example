# =============================================================================
# AI Virtual Task Assistant — environment configuration
# =============================================================================
# Copy this file to `.env` at the repository root and fill in real values:
#
#     cp .env.example .env
#
# Every value below is intentionally blank — this committed template must never
# contain a real secret. The server validates these at boot
# (server/src/config/index.ts):
#   - in production, a missing REQUIRED variable exits the process;
#   - in development/test, a warning is printed and safe local defaults apply.
#
# See docs/deployment.md for the production checklist and per-integration setup.
# =============================================================================

# --- Core runtime -----------------------------------------------------------
# development | test | production (default: development).
NODE_ENV=
# HTTP port for the API server (default: 4000).
PORT=
# Public base URL of this API (e.g. https://api.example.com).
API_URL=
# Public base URL of the SPA (e.g. https://app.example.com). Used for the
# post-OAuth-callback redirect and as the CORS fallback.
APP_URL=

# --- Supabase (required) ----------------------------------------------------
# Supabase → Project Settings → API.
SUPABASE_URL=
# Anonymous/public key — safe to expose to the browser (RLS-scoped).
SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (OpenAI-compatible) ----------------------------------------
# Informational label (e.g. openai, azure-openai, openrouter, groq, ollama).
AI_PROVIDER=
# Provider credential. Sent as `Authorization: Bearer`. Never logged.
AI_API_KEY=
# Chat-completions model id (e.g. gpt-4o-mini).
AI_MODEL=
# Optional. Defaults to https://api.openai.com/v1 when empty.
# OpenAI-compatible providers (Azure OpenAI, OpenRouter, Groq, local servers,
# etc.) may set their own chat-completions base URL here.
AI_BASE_URL=

# --- Notion OAuth + token encryption (required for Notion features) ---------
# Register the redirect URI with Notion exactly as below:
#   http://localhost:4000/api/notion/oauth/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
# Required for token encryption + OAuth-state signing. Must be >= 32 characters.
# Rotating it invalidates existing stored tokens and in-flight OAuth states.
ENCRYPTION_KEY=

# --- Reminders (Phase 13) ---------------------------------------------------
# The reminder scheduler requires Supabase to be configured
# (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY); it stays off otherwise.
# REMINDER_TICK_MS is the worker interval in milliseconds (default 60000).
# REMINDERS_ENABLED accepts true/false (default true).
REMINDER_TICK_MS=
REMINDERS_ENABLED=

# --- Follow-ups (Phase 15) --------------------------------------------------
# The follow-up scheduler requires Supabase to be configured
# (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY); it stays off otherwise.
# FOLLOW_UP_ENABLED accepts true/false (default true).
# FOLLOW_UP_TICK_MS is the worker interval in milliseconds (default 300000).
# FOLLOW_UP_LEAD_HOURS is how far ahead of the deadline to chase (default 24).
# FOLLOW_UP_MIN_INTERVAL_HOURS is the minimum gap between chase-ups (default 20).
# FOLLOW_UP_MAX_PER_TASK caps how many follow-ups a task ever receives (default 3).
# Per-user overrides arrive in Phase 24 (settings).
FOLLOW_UP_ENABLED=
FOLLOW_UP_TICK_MS=
FOLLOW_UP_LEAD_HOURS=
FOLLOW_UP_MIN_INTERVAL_HOURS=
FOLLOW_UP_MAX_PER_TASK=

# --- Notion synchronization (Phase 16) --------------------------------------
# Periodic sync is DISABLED by default and also requires Supabase + Notion to be
# configured. Set SYNC_ENABLED=true to arm the background worker. SYNC_TICK_MS is
# the worker interval in milliseconds (default 900000 = 15 minutes).
# SYNC_MIN_INTERVAL_MS is the per-user cooldown enforced by the manual
# POST /api/sync endpoint (default 10000 = 10 seconds).
# Manual sync via POST /api/sync works regardless of SYNC_ENABLED.
SYNC_ENABLED=
SYNC_TICK_MS=
SYNC_MIN_INTERVAL_MS=

# --- Security hardening (Phase 17) ------------------------------------------
# CORS_ORIGIN restricts browser access to the configured SPA origin(s). Accepts a
# single origin or a comma-separated list. Defaults to APP_URL when empty.
CORS_ORIGIN=
# TRUST_PROXY enables Express `trust proxy` for deployments behind a reverse
# proxy (accepts true/false; default false). Never enable it on a directly
# exposed server, or clients can spoof their IP via X-Forwarded-For.
TRUST_PROXY=
# Rate limiting (express-rate-limit). Window in milliseconds (default 60000) and
# per-window maximums: global /api (300), assistant (30), sync (10), notion (60).
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
RATE_LIMIT_ASSISTANT_MAX=
RATE_LIMIT_SYNC_MAX=
RATE_LIMIT_NOTION_MAX=

# --- Frontend (Vite) --------------------------------------------------------
# Injected into the client bundle at build time. Only the public anon key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
